# Server-only HTTP root containing current.json, previous.json, and versions/.
# Serve versioned files with long-lived immutable caching and keep pointers fresh.
TRANSIT_DATA_BASE_URL=

# Optional trusted local snapshot root for development and tests. Takes precedence over HTTP there.
# Leave this unset in production, where the HTTP root is required.
TRANSIT_DATA_STORAGE_PATH=

# Server-only HTTP root for the small public İETT line/stop/planned-schedule package.
# It must contain current.json, previous.json, and versions/. Keep the trailing slash.
IETT_STATIC_BASE_URL=

# Optional trusted local İETT package root for development and tests only.
# Production rejects this setting and requires the HTTPS base URL above.
IETT_STATIC_STORAGE_PATH=

# Transit routes use the versioned snapshot above; Google Places remains available only for
# place autocomplete/details and other legacy map features, not transit route calculation.
NEXT_PUBLIC_GOOGLE_KEY=
